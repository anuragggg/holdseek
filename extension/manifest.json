{
  "manifest_version": 3,
  "name": "HoldSeek",
  "version": "1.0",
  "description": "Hold the Next/Previous media keys to seek videos. Requires the HoldSeek Mac app.",
  "key": "",
  "icons": { "128": "icon.png" },
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start" }
  ]
}
